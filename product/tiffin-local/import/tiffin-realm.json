{
  "realm": "tiffin",
  "displayName": "Tiffin",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "eventsListeners": [
    "jboss-logging",
    "identity-kafka-outbox"
  ],
  "loginTheme": "tiffin",
  "accountTheme": "tiffin",
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "ar"],
  "defaultLocale": "en",
  "defaultRoles": ["customer"],
  "defaultGroups": ["/cities/seattle"],
  "accessTokenLifespan": 1800,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Orders food"
      },
      {
        "name": "restaurant-manager",
        "description": "Keeps a restaurant's menu and accepts or refuses its orders"
      },
      {
        "name": "courier",
        "description": "Delivers"
      },
      {
        "name": "city-admin",
        "description": "Manages people, roles and restaurants of one city"
      },
      {
        "name": "platform-admin",
        "description": "Manages cities"
      },
      {
        "name": "service",
        "description": "A service of the platform, calling another"
      }
    ]
  },
  "groups": [
    {
      "name": "cities",
      "subGroups": [
        {
          "name": "seattle",
          "attributes": {
            "tenant_id": [
              "seattle"
            ]
          }
        },
        {
          "name": "austin",
          "attributes": {
            "tenant_id": [
              "austin"
            ]
          }
        },
        {
          "name": "platform",
          "attributes": {
            "tenant_id": [
              "platform"
            ]
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "tiffin-app",
      "name": "The Tiffin app (development)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:4411/api/session/callback",
        "http://localhost:4412/api/session/callback"
      ],
      "webOrigins": ["http://localhost:4411", "http://localhost:4412"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tiffin-access-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-access",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-media-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-media",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-restaurants-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-restaurants",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-ordering-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-ordering",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-kitchen-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-kitchen",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-tracking-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-tracking",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-notifications-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-notifications",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tiffin-dispatch-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "tiffin-dispatch",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tiffin-edge",
      "name": "The edge, when it verifies tokens (EDGE_AUTH=keycloak)",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
